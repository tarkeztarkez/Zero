# Lightweight image for small servers: downloads the prebuilt backend binary and
# frontend from a GitHub release instead of compiling on the host.
# Build the release asset with Dockerfile.selfhost (see scripts/selfhost-release.sh).
FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
ARG RELEASE_TAG=selfhost-latest
WORKDIR /app
RUN curl -fsSL "https://github.com/tarkeztarkez/Zero/releases/download/${RELEASE_TAG}/zero-mail-selfhost.tar.gz" | tar -xz -C /app
ENV STATIC_DIR=/app/public PORT=3000
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD curl -fsS http://127.0.0.1:3000/healthz || exit 1
CMD ["/app/zero-server"]
