# Self-hosted Zero: React frontend served by the Rust backend (apps/server-rs).

# ---- frontend ------------------------------------------------------------
FROM node:22-slim AS web
WORKDIR /src
RUN corepack enable && corepack prepare pnpm@10.15.0 --activate
COPY . .
# Scripts are skipped: native addons of the old Cloudflare backend are not needed here.
RUN pnpm install --frozen-lockfile --ignore-scripts --filter @zero/mail...
ARG APP_URL
ENV VITE_PUBLIC_BACKEND_URL=${APP_URL} \
    VITE_PUBLIC_APP_URL=${APP_URL} \
    NODE_ENV=production
RUN pnpm --filter @zero/mail build

# ---- backend -------------------------------------------------------------
FROM rust:1-slim AS api
WORKDIR /src
COPY apps/server-rs/Cargo.toml apps/server-rs/Cargo.lock ./
RUN mkdir src && echo 'fn main() {}' > src/main.rs && cargo build --release && rm -rf src
COPY apps/server-rs/ ./
RUN touch src/main.rs && cargo build --release

# ---- runtime -------------------------------------------------------------
FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=api /src/target/release/zero-server /app/zero-server
COPY --from=web /src/apps/mail/build/client /app/public
ENV STATIC_DIR=/app/public PORT=3000
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD curl -fsS http://127.0.0.1:3000/healthz || exit 1
CMD ["/app/zero-server"]
